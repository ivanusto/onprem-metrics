# Copy to snmp-auth.yml (gitignored). SNMP v3 only, authPriv.
# The user "claude" was created on both NAS; protocols must match what
# the NAS was set to (QTS offers MD5/SHA and DES/AES; use SHA + AES).
auths:
  nas_v3:
    version: 3
    username: claude
    security_level: authPriv
    auth_protocol: SHA
    password: REPLACE-AUTH-PASSPHRASE
    priv_protocol: AES
    priv_password: REPLACE-PRIV-PASSPHRASE
